    linarith
  refine ⟨?_, fun m => ?_⟩
  · rw [Fin.sum_univ_succ, embedZeroSumMomentumCLM_zero]
    simp
  · rw [Finset.sum_filter, Fin.sum_univ_succ, embedZeroSumMomentumCLM_zero]
    refine Fin.cases ?_ ?_ m
    · simp only [le_rfl, ↓reduceIte]
      have h2 : (∑ u : Fin k,
