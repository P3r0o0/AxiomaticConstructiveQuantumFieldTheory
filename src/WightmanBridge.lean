          (1 + ‖ys‖ + 2 * R₀) * (1 + ‖x‖) := by
        have hx0 : 0 ≤ (‖ys‖ + 2 * R₀) * ‖x‖ := by positivity
        linarith
      have h_pow : (1 + ‖zImPoint n x (y₀ + r • d)‖ + R₀) ^ M ≤
