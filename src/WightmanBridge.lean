      x ∈ orderedEuclidN n → 𝒮 n α x = vladimirovSchwinger P.W n α x) :
    WightmanVacuumUnique P.toWightmanPositiveData
        P.wightmanTranslationInvariant ↔
      OSVacuumUnique P.osData P.contraction :=
