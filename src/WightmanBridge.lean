        have hδ_le : δ ≤ R₀ / (‖d‖ + 1) := min_le_right _ _
        have h1 : |t - s| * ‖d‖ < R₀ := by
          calc |t - s| * ‖d‖ ≤ |t - s| * (‖d‖ + 1) :=
                mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
            _ < (R₀ / (‖d‖ + 1)) * (‖d‖ + 1) :=
                mul_lt_mul_of_pos_right (ht_lt.trans_le hδ_le) (by positivity)
