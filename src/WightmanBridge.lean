theorem fourMomentumOSWightmanLinearIsometryEquiv_intertwines_spatialTranslate
    (q : Fin 4 → ℝ)
    (htrans : OSTranslationInvariant (fourMomentumOSData q).𝒮)
    (b : Fin 3 → ℝ) (Φ : OSHilbert (fourMomentumOSData q)) :
