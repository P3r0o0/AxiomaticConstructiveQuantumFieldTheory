  have hdf : HasFDerivAt (repDiagEntry R n α β)
      (ContinuousLinearMap.smulRight (1 : ℂ →L[ℂ] ℂ) (dRepDiag R n α β)) (g_in 0) := by
    have hz : g_in 0 = 0 := by dsimp [g_in]; simp
