  let F_ode : ℝ → ℂ := fun τ =>
    ∫ x : Fin n → Fin 4 → ℝ, H n α (zImPoint n x (y₀ + τ • d)) * (Φ_mul (ψ_ray τ)) x
  have hd_sum : ∀ p : Fin n → Fin 4 → ℝ,
      (∑ k : Fin n, minkowskiInner (p k) (d k)) = -(L_clm p) := by
    intro p
    have h_term : ∀ k : Fin n, minkowskiInner (p k) (d k) =
