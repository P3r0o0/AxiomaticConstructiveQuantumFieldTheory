  vladimirovOSWightmanLinearIsometryEquiv_osVacuum z2FreeOSData z2FreeW
    (momentZeroMomentumSpectrumCondition z2FreeCoeff)
    (fun n α x _ => by
      change z2FreeS n α x = vladimirovSchwinger (momentW z2FreeCoeff) n α x
