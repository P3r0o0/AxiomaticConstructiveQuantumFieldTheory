@[simp]
lemma integral_wightmanConfigTranslate (a : Fin 4 → ℝ)
    (A : WightmanConfig ι) :
    (∫ y : Fin (wightmanConfigTranslate a A).1 → Fin 4 → ℝ,
      (wightmanConfigTranslate a A).2.2.val y) =
      ∫ y : Fin A.1 → Fin 4 → ℝ, A.2.2.val y :=
