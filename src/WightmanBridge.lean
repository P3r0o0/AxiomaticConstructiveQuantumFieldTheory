omit [Fintype ι] [DecidableEq ι] in
lemma wightmanConfigLorentz_mul_apply (A B : SL2C) (C : WightmanConfig ι) :
    wightmanConfigLorentz (A * B) C =
      wightmanConfigLorentz A (wightmanConfigLorentz B C) := by
  rcases C with ⟨n, α, f⟩
