    have h_rhs : y_ext ⟨i.val + 1, hi⟩ 0 = y ⟨m + 1, hm1⟩ 0 :=
      congrArg (fun idx => y_ext idx 0) hi1_eq
    rw [h_lhs, h_rhs]
    have hm_fin : (⟨m, hm0⟩ : Fin k).val + 1 < k := hm1
    exact hy.2 ⟨m, hm0⟩ hm_fin

