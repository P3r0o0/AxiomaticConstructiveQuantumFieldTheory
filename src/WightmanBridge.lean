def WightmanVacuumNormalized {R : HolomorphicLorentzRep ι}
    (S : StarStructure R) (W : WightmanFamily ι) : Prop :=
  wightmanKernel S W (wightmanVacuumConfig ι) (wightmanVacuumConfig ι) = 1

