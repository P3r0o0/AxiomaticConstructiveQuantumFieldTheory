      _ ≤ ‖r‖ + ∑ u : Fin k, ‖r (Fin.natAdd 1 u)‖ :=
        add_le_add (norm_le_pi_norm r _) (norm_sum_le _ _)
      _ ≤ ‖r‖ + ∑ _u : Fin k, ‖r‖ :=
        add_le_add le_rfl (Finset.sum_le_sum fun u _ => norm_le_pi_norm r _)
