      ‖iteratedFDeriv ℝ q
        (fun y : Fin (j + k) → Fin 4 → ℝ => (starRingEnd ℂ) (f (concatProjLeftCLM j k y))) x‖ ≤
      SchwartzMap.seminorm ℝ l q f := by
  let L := concatProjLeftCLM j k
