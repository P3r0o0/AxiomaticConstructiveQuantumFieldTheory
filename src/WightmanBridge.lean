noncomputable def toWightmanAxiomsWithUniqueVacuum
    (P : OSReconstructedWightman R S η 𝒮)
    (h_schw : ∀ (n : ℕ) (α : Fin n → ι) (x : Fin n → Fin 4 → ℝ),
      x ∈ orderedEuclidN n → 𝒮 n α x = vladimirovSchwinger P.W n α x)
