    (D : OSReflectionPositiveData R S) (Φ : OSConfig ι → H)
    (h_ker : ∀ A B : OSConfig ι, ⟪Φ A, Φ B⟫_ℂ = osKernel S D.𝒮 A B)
    (A : OSConfig ι) :
    wavepacketOSCLM D Φ h_ker (osBasis D A) = Φ A := by
  dsimp [osBasis]
  rw [wavepacketOSCLM_toOSHilbert, wavepacketOSPreLM_osBasisPre]

