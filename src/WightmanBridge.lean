      · simp [d, hk, minkowskiInner_explicit]
    simp_rw [h_term]
    rw [← Finset.sum_filter, Finset.sum_neg_distrib]
    change -(∑ k ∈ Finset.univ.filter (· ≤ m), minkowskiInner (p k) w) =
