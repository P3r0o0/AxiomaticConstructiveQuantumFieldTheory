theorem schwingerFromPermutedTube_permutation_euclid
    (R : HolomorphicLorentzRep ι) (W : WightmanFamily ι) {η : ℂ} (hη : η = 1 ∨ η = -1)
    (E : TubeExtension W) (hperm_ext : EuclidExtendedTubePermLocality η (spinor_H_ext R W E)) :
