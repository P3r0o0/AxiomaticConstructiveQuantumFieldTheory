    {ε : ℂ} (hε : R.HasSpinParity ε)
    (h_nondeg : ∃ (n : ℕ) (_ : 1 ≤ n) (α : Fin n → ι)
      (f : SchwartzMap (Fin n → Fin 4 → ℝ) ℂ), P.W n α f ≠ 0) :
    η = ε := by
  by_contra h_wrong
  rcases h_nondeg with ⟨n, hn, α, f, hf⟩
  exact hf ((P.wrong_statistics_all_nPoint_eq_zero hε h_wrong).2.2.1 n hn α f)

