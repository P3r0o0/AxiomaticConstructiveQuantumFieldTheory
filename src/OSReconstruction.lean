      have hC : (chiralDoubleStarStructure R hR).C (Sum.inr c) (β 0) = 0 := by
        rcases h0 : β 0 with a | a
        · change (1 : Matrix ι ι ℂ) c a = 0
          refine Matrix.one_apply_ne (fun hca => hβ0 ?_)
          rw [h0, hca]
