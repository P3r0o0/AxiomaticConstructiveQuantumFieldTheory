        ≤ ‖logTimeDamp (w i_cut)‖ ^ M * Real.sqrt (B_L * B_R) * (1 + (2 * ε₀)⁻¹) ^ M := h_bd
      _ = Real.sqrt (B_L * B_R) * (‖logTimeDamp (w i_cut)‖ * (1 + (2 * ε₀)⁻¹)) ^ M := by
          rw [mul_pow]; ring
