    stdRep_hasDiagInvolutivePT diagonalStarStructure_stdStarStructure ⟨2, by omega, α, f, hf⟩

theorem vector_os_spin_statistics_any_nPoint_unconditional {η : ℂ} {𝒮 : SchwingerFamily (Fin 4)}
